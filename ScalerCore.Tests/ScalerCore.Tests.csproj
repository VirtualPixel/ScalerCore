<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ScalerCore.Tests</AssemblyName>
    <RootNamespace>ScalerCore.Tests</RootNamespace>
  </PropertyGroup>

  <!-- The grounding decision is deliberately free of Unity types, so it compiles straight
       into the test assembly. A project reference would drag in the whole plugin and the
       game assemblies, which have no runtime outside the game. -->
  <ItemGroup>
    <Compile Include="../Handlers/EnemyVisuals/GroundingTrack.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

</Project>
